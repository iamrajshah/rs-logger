{
  "name": "rs-logger",
  "version": "1.1.0",
  "description": "TypeScript-first Winston wrapper with structured metadata, safe Error serialization, child loggers, and graceful shutdown.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc && babel src --out-dir lib --extensions .ts,.js --ignore '**/*.test.ts'",
    "clean": "rm -rf lib",
    "format": "prettier --write \"**/*.{js,ts,mjs,cjs,json,css,scss,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,mjs,cjs,json,css,scss,md,yml,yaml}\"",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepack": "npm run verify",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "verify": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamrajshah/rs-logger.git"
  },
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "winston",
    "structured-logging",
    "error-handling",
    "nodejs"
  ],
  "author": {
    "name": "Rajesh Jitendra Shah",
    "email": "shahrajesh2113@yahoo.com",
    "url": "https://github.com/iamrajshah"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iamrajshah/rs-logger/issues"
  },
  "homepage": "https://github.com/iamrajshah/rs-logger#readme",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.28.3",
    "@types/node": "^24.10.1",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.1",
    "eslint-plugin-babel": "^5.3.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "winston": "3.18.3",
    "winston-transport": "^4.9.0"
  }
}
